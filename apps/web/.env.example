# Variables pour l'import des scores depuis Instagram (feat/social-scores).
# Copie ce fichier en .env.local pour le dev, et renseigne les mêmes noms dans
# Vercel → Project → Settings → Environment Variables. Ne commite jamais de vraie valeur.

# --- Lecture des visuels par Claude ---------------------------------------
# Clé créée sur https://platform.claude.com → API Keys (facturation à l'usage,
# séparée de l'abonnement Claude).
ANTHROPIC_API_KEY=
# Modèle utilisé pour lire les visuels (optionnel). Défaut : claude-haiku-5-5.
# Pour plus de précision : claude-opus-5-5 (environ 40 fois plus cher).
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Instagram Graph API (Business Discovery) ------------------------------
# Token d'accès longue durée d'une app Meta reliée à TON compte Instagram
# Business/Créateur (permissions : instagram_basic, pages_show_list,
# pages_read_engagement). Il expire au bout de ~60 jours : à renouveler.
INSTAGRAM_ACCESS_TOKEN=
# ID numérique de ton compte Instagram Business (pas le @pseudo).
# Business Discovery l'utilise pour lire les posts publics des comptes des clubs.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Version de l'API Graph (optionnel).
META_GRAPH_API_VERSION=v23.0

# --- Écriture en base -------------------------------------------------------
# Clé service_role de Supabase (Settings → API). Côté serveur uniquement :
# ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron -------------------------------------------------------------------
# Déjà utilisée par /api/cron/sync ; la future route /api/cron/social la réutilise.
CRON_SECRET=
