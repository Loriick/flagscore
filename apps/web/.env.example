# Variables pour l'import des scores publiés par les clubs sur Instagram.
# Copie ce fichier en .env.local pour le dev, et renseigne les mêmes noms dans
# Vercel → Project → Settings → Environment Variables. Ne commite jamais de vraie valeur.

# --- Lecture des visuels par Claude ---------------------------------------
# Clé créée sur https://platform.claude.com → API Keys (facturation à l'usage,
# séparée de l'abonnement Claude).
ANTHROPIC_API_KEY=
# Modèle utilisé pour lire les visuels (optionnel). Défaut : claude-haiku-5-5.
# Pour plus de précision : claude-opus-5-5 (environ 40 fois plus cher).
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Collecte des posts Instagram (Apify) --------------------------------
# Jeton API Apify : https://console.apify.com/settings/integrations
# Utilisé pour lancer l'Actor apify/instagram-scraper sur les comptes des clubs.
APIFY_TOKEN=

# --- Écriture en base -------------------------------------------------------
# Clé service_role de Supabase (Settings → API). Côté serveur uniquement :
# ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron -------------------------------------------------------------------
# Utilisée par /api/cron/sync et /api/cron/social (obligatoire pour cette dernière).
# Vercel l'envoie automatiquement aux crons dans l'en-tête Authorization.
CRON_SECRET=
