# Site public (flagscore.fr).
# Copie ce fichier en .env.local pour le dev, et renseigne les mêmes noms dans
# Vercel → Project → Settings → Environment Variables. Ne commite jamais de vraie valeur.

# --- Supabase (lecture publique) --------------------------------------------
# Settings → API : URL du projet et clé anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON=

# --- Formulaire de contact --------------------------------------------------
RESEND_API_KEY=

# --- Cron -------------------------------------------------------------------
# Utilisée par /api/cron/sync. Vercel l'envoie automatiquement aux crons dans
# l'en-tête Authorization. L'import Instagram (/api/cron/social) est dans
# apps/admin.
CRON_SECRET=
