{
  "buildCommand": "cd ../.. && pnpm build --filter=@flagscore/web",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/social?step=start",
      "schedule": "0 18 * * 1,3"
    },
    {
      "path": "/api/cron/social?step=process&slot=1",
      "schedule": "0 19 * * 1,3"
    },
    {
      "path": "/api/cron/social?step=process&slot=2",
      "schedule": "0 20 * * 1,3"
    },
    {
      "path": "/api/cron/social?step=process&slot=3",
      "schedule": "0 6 * * 2,4"
    }
  ]
}
