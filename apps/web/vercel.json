{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm build --filter=@flagscore/web",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "schedules": {
    "social-start": {
      "schedule": "0 19 * * 1,3",
      "timezone": "Europe/Paris",
      "path": "/api/cron/social?step=start",
      "requestMethod": "GET"
    },
    "social-process-1": {
      "schedule": "0 20 * * 1,3",
      "timezone": "Europe/Paris",
      "path": "/api/cron/social?step=process&slot=1",
      "requestMethod": "GET"
    },
    "social-process-2": {
      "schedule": "0 21 * * 1,3",
      "timezone": "Europe/Paris",
      "path": "/api/cron/social?step=process&slot=2",
      "requestMethod": "GET"
    },
    "social-process-3": {
      "schedule": "0 7 * * 2,4",
      "timezone": "Europe/Paris",
      "path": "/api/cron/social?step=process&slot=3",
      "requestMethod": "GET"
    }
  }
}
