# Admin (admin.flagscore.fr) : plateaux, délégués, validation des scores,
# import des scores Instagram.
# Copie ce fichier en .env.local pour le dev, et renseigne les mêmes noms dans
# Vercel → Project → Settings → Environment Variables. Ne commite jamais de vraie valeur.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON=
# Clé service_role (Settings → API). Côté serveur uniquement : ne jamais la
# préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Invitations des délégués -----------------------------------------------
# URL de l'app des délégués, base des liens de connexion envoyés par email.
# En dev : http://localhost:3002
MATCHS_URL=https://matchs.flagscore.fr
RESEND_API_KEY=
# Expéditeur des invitations, sur un domaine vérifié dans Resend.
# Défaut : Flagscore <onboarding@resend.dev> (adresse de test Resend).
RESEND_FROM=

# --- Import des scores Instagram (/api/cron/social) -------------------------
# Clé créée sur https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
# Modèle utilisé pour lire les visuels (optionnel). Défaut : claude-haiku-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5
# Jeton API Apify : https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Vercel l'envoie automatiquement aux crons dans l'en-tête Authorization.
CRON_SECRET=
