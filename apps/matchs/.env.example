# App des délégués de match (matchs.flagscore.fr).
# Copie ce fichier en .env.local pour le dev, et renseigne les mêmes noms dans
# Vercel → Project → Settings → Environment Variables. Ne commite jamais de vraie valeur.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON=
# Clé service_role (Settings → API). Côté serveur uniquement : ne jamais la
# préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
